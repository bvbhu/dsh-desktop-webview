<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offscreen render harness for UI eyeballing. Must be a WPF project: the control lives in a
       net8.0-windows assembly, which Windows PowerShell 5.1 (.NET Framework) cannot load.
       Under /tools and NOT in the solution, so it never ships. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PickerPreview</AssemblyName>
    <RootNamespace>PickerPreview</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference the real app so the preview renders the real control, not a copy.
         Private=true: deploy DSH-Desktop-Webview.dll beside the harness or it dies at startup. -->
    <ProjectReference Include="..\..\src\DshDesktop.App\DshDesktop.App.csproj">
      <Private>true</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
