<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders the REAL SettingsWindow offscreen to a PNG so the layout can be eyeballed without
       UI-automating the live app. Dev-only; deliberately NOT in the .sln. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SettingsPreview</RootNamespace>
    <AssemblyName>SettingsPreview</AssemblyName>
    <EnabledDefaultItems>true</EnabledDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pack URIs bind to the ENTRY assembly: app.ico and Themes/*.xaml must exist here at the same
         relative paths or the window dies at InitializeComponent. Link= preserves the path. -->
    <Resource Include="..\..\src\DshDesktop.App\app.ico" Link="app.ico" />
    <Page Include="..\..\src\DshDesktop.App\Themes\Dark.xaml" Link="Themes\Dark.xaml" />
    <Page Include="..\..\src\DshDesktop.App\Themes\Light.xaml" Link="Themes\Light.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=true: without it the app assembly is not copied next to the harness and startup dies. -->
    <ProjectReference Include="..\..\src\DshDesktop.App\DshDesktop.App.csproj">
      <Private>true</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
