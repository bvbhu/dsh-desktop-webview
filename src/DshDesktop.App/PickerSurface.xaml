<UserControl x:Class="DshDesktop.App.PickerSurface"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cp="clr-namespace:ColorPicker;assembly=ColorPicker">
    <!-- 三方取色控件的唯一落点。隔离在这一层有两个原因：
         ① 我们的控件类就叫 ColorPicker，与库的命名空间同名 —— 在那一类里写 ColorPicker.Xxx
            会被解析成我们自己的类（编译期就报「类型 ColorPicker 中不存在类型名 ColorSliders」）；
         ② 换库/升级库时只需要动这一个文件。 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 色相环 + 饱和度/明度方块 -->
        <cp:SquarePicker Grid.Column="0"
                         Width="176" Height="176"
                         Style="{DynamicResource ColorPickerHostStyle}"
                         SelectedColor="{Binding Color, ElementName=Root, Mode=TwoWay}" />

        <!-- SelectedColor 的元数据不是默认双向，Mode=TwoWay 必须显式写，否则拖动取色器回不到配置。 -->
        <cp:ColorSliders x:Name="Sliders" Grid.Column="1" Margin="12,0,0,0"
                         Style="{DynamicResource ColorPickerHostStyle}"
                         SelectedColor="{Binding Color, ElementName=Root, Mode=TwoWay}" />
    </Grid>
</UserControl>
