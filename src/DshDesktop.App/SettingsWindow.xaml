<Window x:Class="DshDesktop.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DshDesktop.App"
        xmlns:conv="clr-namespace:DshDesktop.App.Converters"
        Title="设置"
        Width="640" Height="780"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        Icon="pack://application:,,,/app.ico">

    <Window.Resources>
        <conv:EnumToBoolConverter x:Key="EnumBool" />
        <conv:NotNullToVisibilityConverter x:Key="NotNullVis" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
    </Window.Resources>

    <!-- 版式取自参考图：每张卡片 = 若干「内联字段名 + 灰色说明」行，下面跟着全宽输入框。
         说明一律用 local:SelectableHint（可选中复制），不是 TextBlock。
         数据源分治：整窗绑 SettingsViewModel；控制台卡片绑窗口自身（见 .xaml.cs 的说明）。
         无顶部独立错误条 —— 错误内联进控制台标题行，使"出了什么错 / 该做什么"同屏同卡片。 -->
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 可滚动内容区 ============ -->
        <ScrollViewer x:Name="ContentScroll" Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      Padding="16,12,16,8">
            <StackPanel MaxWidth="580" HorizontalAlignment="Stretch">

                <!-- ===== 默认 URL（独立面板，设置页第一项；控制台紧随其后第二项）===== -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <local:SelectableHint Label="URL"
                                              Text="软件启动后尝试访问的地址。示例：http://127.0.0.1:3080/"
                                              Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource SettingsTextBoxStyle}" Margin="0"
                                 Text="{Binding DefaultUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <!-- ===== 控制台（设置页第二项；它仍是"现在发生了什么"的唯一出口）=====
                     这一栏收拢三件与"当前状态"直接相关的东西：
                     ① 错误信息（内联在标题行）；
                     ② 需要临时 URL 时的提示与输入框（NeedsToken 才出现，在输出区之前）；
                     ③ 控制台输出本身。 -->
                <Border x:Name="ConsoleArea" Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="控制台" Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center" />
                            <!-- 错误内联在标题行：无错误时整段缩起（NotNullToVisibilityConverter），
                                 有错误时红字紧跟标题，超长省略号截断、悬停看全文。
                                 字号必须与标题一致（13px）：同字号 + 同为 Center 对齐，
                                 两段文字必然落在同一中线上（2026-09-14 用户要求同行元素不错位）。 -->
                            <TextBlock Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource ErrorTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding ErrorText, Converter={StaticResource NotNullVis}}"
                                       ToolTip="{Binding ErrorText, Mode=OneWay}">
                                <Run Text="错误：" FontWeight="Medium" />
                                <Run Text="{Binding ErrorText, Mode=OneWay}" />
                            </TextBlock>
                            <!-- 主动作分两档：清 Cookie 只丢登录态，清数据是整套本地存储。
                                 都放在控制台标题行，因为它们的结果都只出现在控制台里（见 OnClearCookiesRequested）。
                                 三种元素（标题 / 错误 / 按钮）统一 VerticalAlignment=Center：
                                 按钮再高也只向上下对称伸展，文字中线一致，不会出现谁比谁低一截。 -->
                            <Button Grid.Column="2" Style="{StaticResource SettingsButtonStyle}"
                                    Padding="12,4" VerticalAlignment="Center"
                                    Content="清除 WebView 数据" Click="OnClearWebViewData"
                                    ToolTip="清空缓存 / 本地存储 / IndexedDB 等全部浏览数据（含 Cookie，页面需刷新后才会体现）" />
                            <Button Grid.Column="3" Style="{StaticResource SettingsButtonStyle}"
                                    Padding="12,4" VerticalAlignment="Center" Margin="8,0,0,0"
                                    Content="清除 Cookie" Click="OnClearCookies"
                                    ToolTip="只清空 WebView2 的全部 Cookie（页面需刷新后才会体现为登出）" />
                        </Grid>

                        <!-- 临时 URL 区（仅 NeedsToken 时可见），在输出区之前：
                             用户此刻唯一要做的就是粘贴 URL，不能让它垫在输出区下面。
                             隐藏时输出区紧跟标题行。 -->
                        <StackPanel x:Name="TempUrlPanel"
                                    Visibility="{Binding NeedsTokenVisibility}"
                                    Margin="0,0,0,12">
                            <TextBlock Text="服务可能需要认证。请在下方填写带 token 的 URL 以打开页面："
                                       Style="{StaticResource HintTextStyle}"
                                       Foreground="{DynamicResource ErrorTextBrush}" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TempUrlInput"
                                         Grid.Column="0"
                                         Style="{StaticResource SettingsTextBoxStyle}"
                                         Margin="0,0,8,0" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource PrimaryButtonStyle}" Margin="0"
                                        Content="打开"
                                        Click="OnProvideTempUrl" />
                            </Grid>
                        </StackPanel>

                        <!-- 「跟随滚动」与「不占用整页」的折中（用户要求跟随滚动，但又反馈窗口过高）：
                             默认高度 180px，不再随内容无限长高；右下角有捏手，可拖到任意高度
                             （上限只有窗口本身）。控制台内容超出时文本框自己滚动。
                             WPF 的 TextBox 没有任何内置缩放属性（ResizeMode 是 Window 的），
                             所以捏手用 Thumb 自己实现，见 SettingsWindow.xaml.cs 的 OnConsoleGripDrag。 -->
                        <TextBox x:Name="ConsoleBox"
                                 IsReadOnly="True"
                                 FontFamily="Consolas, Courier New, monospace"
                                 FontSize="11"
                                 Padding="8,6"
                                 MinHeight="120"
                                 MinWidth="200"
                                 Height="180"
                                 Background="{DynamicResource InputBackgroundBrush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource PanelBorderBrush}"
                                 BorderThickness="1,1,1,0"
                                 Text="{Binding ConsoleText, Mode=OneWay}"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" />

                        <!-- 缩放捏手：贴在控制台底边，只吃自己的鼠标事件，不影响正文滚动与选中 -->
                        <Thumb x:Name="ConsoleGrip"
                               Height="10"
                               Cursor="SizeNS"
                               Background="{DynamicResource PanelBorderBrush}"
                               DragDelta="OnConsoleGripDrag"
                               ToolTip="拖动调整控制台高度" />
                    </StackPanel>
                </Border>

                <!-- ===== 本地服务 ===== -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="本地服务启动策略" Style="{StaticResource SectionHeaderStyle}" />

                        <StackPanel Orientation="Horizontal" Margin="0,2,0,14">
                            <RadioButton GroupName="Strategy" Style="{StaticResource SettingsRadioStyle}"
                                         Content="不启动，直接打开url"
                                         IsChecked="{Binding ServiceStrategy, Mode=TwoWay, Converter={StaticResource EnumBool}, ConverterParameter=NeverStart}" />
                            <RadioButton GroupName="Strategy" Style="{StaticResource SettingsRadioStyle}"
                                         Content="先尝试打开url，未在运行才启动服务"
                                         IsChecked="{Binding ServiceStrategy, Mode=TwoWay, Converter={StaticResource EnumBool}, ConverterParameter=ProbeThenStart}" />
                            <RadioButton GroupName="Strategy" Style="{StaticResource SettingsRadioStyle}"
                                         Content="直接启动"
                                         IsChecked="{Binding ServiceStrategy, Mode=TwoWay, Converter={StaticResource EnumBool}, ConverterParameter=AlwaysStart}" />
                        </StackPanel>

                        <!-- 启动配置块：选了「不启动，直接打开url」就整块实时隐藏 ——
                             不启动服务就没有可配置的启动参数（用户要求，2026-09-14）。
                             Visibility 走 ServiceNeverStart 派生属性的 INPC 通知，切换单选立即生效。 -->
                        <StackPanel Visibility="{Binding ServiceNeverStart, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">

                            <local:SelectableHint Label="工作目录"
                                                  Text="启动命令的工作目录。留空则默认软件所在目录。"
                                                  Margin="0,0,0,6" />
                            <TextBox Style="{StaticResource SettingsTextBoxStyle}" Margin="0,0,0,14"
                                     Text="{Binding WorkingDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <local:SelectableHint Label="启动命令"
                                                  Text="示例：dsh web --no-open"
                                                  Margin="0,0,0,6" />
                            <TextBox Style="{StaticResource SettingsTextBoxStyle}" Margin="0,0,0,14"
                                     Text="{Binding LaunchCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <local:SelectableHint Label="URL 提取正则"
                                                  Text="按该正则从命令输出提取URL，必须包含命名捕获组 url。&#x0a;示例：dsh web:\s*(?&lt;url&gt;https?://\S+)"
                                                  Margin="0,0,0,6" />
                            <TextBox Style="{StaticResource MonoTextBoxStyle}" Margin="0,0,0,14"
                                     Text="{Binding UrlExtractRegex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <local:SelectableHint Label="成功标志正则"
                                                  Text="匹配该正则就认为服务已就绪，打开url"
                                                  Margin="0,0,0,6" />
                            <TextBox Style="{StaticResource MonoTextBoxStyle}" Margin="0"
                                     Text="{Binding SuccessMarkerRegex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== 窗口控制按钮（2026-09-14 按设计图重排）===== -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <!-- 标题行：「窗口控制按钮」+ 显示/隐藏 单选内联（设计图 2）。
                             原先那条"鼠标移入右上角后切换；移出恢复"说明收进 ToolTip。 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="窗口控制按钮" Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center" />
                            <RadioButton Grid.Column="2" GroupName="ChromeButtons" Style="{StaticResource SettingsRadioStyle}"
                                         Content="显示" ToolTip="鼠标移入右上角后切换；移出恢复。"
                                         IsChecked="{Binding ChromeButtonsDefault, Mode=TwoWay, Converter={StaticResource EnumBool}, ConverterParameter=Shown}" />
                            <RadioButton Grid.Column="3" GroupName="ChromeButtons" Style="{StaticResource SettingsRadioStyle}"
                                         Margin="14,0,0,0"
                                         Content="隐藏" ToolTip="鼠标移入右上角后切换；移出恢复。"
                                         IsChecked="{Binding ChromeButtonsDefault, Mode=TwoWay, Converter={StaticResource EnumBool}, ConverterParameter=Hidden}" />
                        </Grid>

                        <local:SelectableHint Label="悬停延迟 (ms)"
                                              Text="鼠标移入右上角后多少毫秒切换窗口控制按钮显示，默认值：800"
                                              Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource SettingsTextBoxStyle}" Margin="0,0,0,14"
                                 Text="{Binding ChromeHoverDelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- 背景颜色行（设计图 2）：标签 + 「跟随系统」复选框 + 取色器同行。
                             勾选「跟随系统」= 底色留空、随主题切换，此时取色器整块**实时隐藏**
                             （用户要求；此前是 IsEnabled 置灰）。Grid 两列而非横向 StackPanel：
                             SelectableHint / 带宽度约束的控件在横向 StackPanel 里量不出宽度。 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="背景颜色" Style="{StaticResource FieldLabelStyle}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <CheckBox Grid.Column="1" Style="{StaticResource SettingsCheckBoxStyle}"
                                      Content="跟随系统" VerticalAlignment="Center" Margin="0,0,12,0"
                                      ToolTip="勾选时窗口控制按钮不设底色，随主题自动切换；此时无需选择颜色。"
                                      IsChecked="{Binding ChromeButtonBackgroundFollowTheme, Mode=TwoWay}" />
                            <!-- InvertHidden 而非 Invert：勾选「跟随系统」时取色器只隐形不缩起，
                                 行高保持不变（用户要求：切换不得影响行高）。 -->
                            <local:ColorPickerField Grid.Column="2" VerticalAlignment="Center"
                                                    AllowEmpty="False"
                                                    Visibility="{Binding ChromeButtonBackgroundFollowTheme, Converter={StaticResource BoolVis}, ConverterParameter=InvertHidden}"
                                                    ColorHex="{Binding ChromeButtonBackground, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== 拖动层（2026-09-14 按设计图重排）===== -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <!-- 标题行：「拖动层」+ 说明内联 + 「启用」复选框右对齐（设计图 1） -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="拖动层" Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center" />
                            <local:SelectableHint Grid.Column="1" VerticalAlignment="Center" Margin="10,0,12,0"
                                                  Text="覆盖在页面上方的拖动层，会挡住其覆盖区域的页面交互。" />
                            <CheckBox Grid.Column="2" Style="{StaticResource SettingsCheckBoxStyle}"
                                      Content="启用" VerticalAlignment="Center"
                                      IsChecked="{Binding DragStripEnabled, Mode=TwoWay}" />
                        </Grid>

                        <!-- 配置块：未启用拖动层就整块实时隐藏 —— 用户要求（2026-09-14）。
                             Visibility 直接绑 DragStripEnabled 的 INPC 通知，切换立即生效。 -->
                        <StackPanel Visibility="{Binding DragStripEnabled, Converter={StaticResource BoolVis}}">
                            <!-- 三个尺寸字段与「颜色和透明度」同行（设计图 1）；默认值说明移到块底 -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                    <TextBlock Text="左侧留空 (px)" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Style="{StaticResource SettingsTextBoxStyle}" Width="92" Margin="0,4,0,0"
                                             Text="{Binding DragStripLeftInset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                    <TextBlock Text="高度 (px)" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Style="{StaticResource SettingsTextBoxStyle}" Width="92" Margin="0,4,0,0"
                                             Text="{Binding DragStripHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,14,0">
                                    <TextBlock Text="右侧留空 (px)" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Style="{StaticResource SettingsTextBoxStyle}" Width="92" Margin="0,4,0,0"
                                             Text="{Binding DragStripRightInset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="颜色和透明度" Style="{StaticResource FieldLabelStyle}" />
                                    <local:ColorPickerField Margin="0,4,0,0" ShowAlphaSlider="True" AllowEmpty="False"
                                                            ColorHex="{Binding DragStripArgb, Mode=TwoWay}" />
                                </StackPanel>

                                <!-- 占位列：四列内容靠左，富余宽度留在右边 -->
                                <TextBlock Grid.Column="4" />
                            </Grid>

                            <local:SelectableHint
                                Text="默认值依次为：280（DSH左侧栏宽度）、40（窗口控制按钮高度）、138（窗口控制按钮宽度）、透明（不可见）" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ============ 校验错误条 ============ -->
        <Border Grid.Row="1"
                Background="{DynamicResource ErrorTextBrush}"
                Padding="16,8"
                Visibility="{Binding ValidationError, Converter={StaticResource NotNullVis}}">
            <TextBlock Text="{Binding ValidationError}" Foreground="White" FontSize="12" />
        </Border>

        <!-- ============ 操作按钮行 ============ -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="保存"
                        Click="OnSave"
                        ToolTip="写盘并立即套用三键与拖动层的外观" />
                <Button Style="{StaticResource SettingsButtonStyle}" Content="取消"
                        Click="OnCancel"
                        ToolTip="放弃未保存的改动（直接关窗等同于取消）" />
                <Button Style="{StaticResource SettingsButtonStyle}" Content="重置外观"
                        Click="OnResetAppearance"
                        ToolTip="把外观相关的字段恢复为出厂默认值" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
