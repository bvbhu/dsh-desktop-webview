<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 窗口 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#D6D6D6" />

    <!-- 三键：底色与悬停色不透明，理由见 Dark.xaml -->
    <SolidColorBrush x:Key="ChromeButtonIconBrush" Color="#000000" />
    <SolidColorBrush x:Key="ChromeButtonBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ChromeButtonHoverBackgroundBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="CloseButtonHoverBackgroundBrush" Color="#E81123" />

    <!-- 文本 -->
    <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#6B6B6B" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#C62828" />

    <!-- 卡片与输入 -->
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F7F7F7" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#ECECEC" />
    <SolidColorBrush x:Key="SwatchBorderBrush" Color="#C0C0C0" />

    <!-- 强调色 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3D9BFF" />

    <!-- PixiEditor 颜色选择器在本主题下不套任何覆盖（空样式 = 它自带的 WPF 原生浅色外观，
         离线渲染确认过：白底上的浅色色相环/滑轨/数值框都正常）。
         这个键必须存在 —— 控件是用 DynamicResource 引用它的，换主题时靠 Dark.xaml 里那份生效。 -->
    <Style x:Key="ColorPickerHostStyle" TargetType="UserControl" />
</ResourceDictionary>
