<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 窗口 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#3C3C3C" />

    <!-- 三键：底色与悬停色必须**不透明** —— 它们浮在页面之上，半透明会让页面内容透上来。 -->
    <SolidColorBrush x:Key="ChromeButtonIconBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ChromeButtonBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="ChromeButtonHoverBackgroundBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="CloseButtonHoverBackgroundBrush" Color="#E81123" />

    <!-- 文本 -->
    <SolidColorBrush x:Key="TextBrush" Color="#E8E8E8" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FF7B72" />

    <!-- 卡片与输入 -->
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#252526" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#3C3C3C" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="SwatchBorderBrush" Color="#5A5A5A" />

    <!-- 强调色 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4C9AFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6DB0FF" />

    <!-- PixiEditor 颜色选择器的暗色外观：直接复用库自带字典，它的主背景 #252525 与本主题的
         PanelBackgroundBrush #252526 几乎重合。Light.xaml 里同名键为空样式（用 WPF 原生浅色外观），
         控件用 DynamicResource 引用，换主题会自动跟着换。 -->
    <Style x:Key="ColorPickerHostStyle" TargetType="UserControl">
        <Style.Resources>
            <ResourceDictionary Source="pack://application:,,,/ColorPicker;component/Styles/DefaultColorPickerStyle.xaml" />
        </Style.Resources>
    </Style>
</ResourceDictionary>
